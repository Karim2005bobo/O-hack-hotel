# Порт на хосте (внутри контейнера приложение всегда слушает 8080)
APP_PORT=8080

# --- LLM (опционально). Без ключа агент работает на встроенных правилах разбора русского языка.
# Любой OpenAI-совместимый API. С LLM агент понимает любые формулировки и любые места мира.
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# Также: OpenAI, vLLM, Ollama (http://host.docker.internal:11434/v1), шлюзы к YandexGPT/GigaChat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# --- Хранилище (SQLite в docker volume)
DB_PATH=/data/agent.db

# --- Telegram-бот (опционально): тот же агент в мессенджере
TELEGRAM_BOT_TOKEN=

# --- Зафиксировать «сегодня» для воспроизводимого демо (YYYY-MM-DD), пусто — реальная дата
APP_TODAY=

LOG_LEVEL=INFO
